# LUMIO Client Environment Configuration
VITE_APP_NAME=LUMIO
VITE_APP_TAGLINE=Virtual Labs. Limitless Learning.
VITE_APP_BRAND_STATEMENT=Explore. Experiment. Execute.
VITE_APP_ENV=production

# Feature Flags
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_IOT_LAB=true
VITE_ENABLE_AI_LAB=true
VITE_ENABLE_COLLABORATION=true

# Endpoints (Leave empty or omit in unified production deployments to auto-detect current origin)
VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_COLLABORATION_URL=

# Firebase Web App configuration (public client config, protected by Firebase rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
